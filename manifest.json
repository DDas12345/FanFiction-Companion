{
  "manifest_version": 3,
  "name": "FanFiction Companion",
  "version": "1.0.0",
  "description": "Your personal reading companion for FanFiction.Net",
  "permissions": ["storage", "tabs"],
  "content_scripts": [
    {
      "matches": ["https://www.fanfiction.net/*", "https://fanfiction.net/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "FanFiction Companion",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/icon48.png"],
      "matches": ["https://www.fanfiction.net/*"]
    }
  ]
}
